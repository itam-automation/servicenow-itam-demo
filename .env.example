# Vorlage. Als .env kopieren und selbst ausfüllen. Die .env wird nie eingecheckt.
#   cp .env.example .env
#
# Instanz-URL der persönlichen Entwicklerinstanz (PDI), ohne Schrägstrich am Ende
SN_INSTANCE_URL=https://devXXXXXX.service-now.com

# Integrationsbenutzer für den Loader (Baustein 2).
# Empfehlung: eigener Benutzer in der Instanz, nicht der admin-Benutzer.
SN_USER=
SN_PASSWORD=

# Nur lesender Benutzer für den KI-Assistenten (Baustein 5), wird später ergänzt.
# SN_READONLY_USER=
# SN_READONLY_PASSWORD=
