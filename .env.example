# Vorlage. Als .env kopieren und selbst ausfüllen. Die .env wird nie eingecheckt.
#   cp .env.example .env
#
# Instanz-URL der persönlichen Entwicklerinstanz (PDI), ohne Schrägstrich am Ende
SN_INSTANCE_URL=https://devXXXXXX.service-now.com

# Integrationsbenutzer für den Loader (Baustein 2).
# Empfehlung: eigener Benutzer in der Instanz, nicht der admin-Benutzer.
SN_USER=
SN_PASSWORD=

# Pfad der Scripted REST API «ITAM Demo» (Namespace ist je Instanz verschieden)
SN_ITAM_API=/api/<namespace>/itam_demo

# Optional: Pfad der REST API des ITAM-Toolkits. Ohne Angabe wird er aus SN_ITAM_API abgeleitet
# (/api/x_<namespace>_itamkit/toolkit). Der Benutzer braucht die Rolle x_<namespace>_itamkit.user.
# SN_TOOLKIT_API=/api/x_<namespace>_itamkit/toolkit

# Nur lesender Benutzer für den KI-Assistenten (Baustein 5)
# SN_READONLY_USER=
# SN_READONLY_PASSWORD=

# Schlüssel für die Claude API (KI-Assistent); alternativ als Umgebungsvariable
# ANTHROPIC_API_KEY=
